{
  "name": "focus-code",
  "version": "0.4.0",
  "type": "module",
  "description": "A local code change review plugin for coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihuzhou/focus-code.git"
  },
  "keywords": [
    "git",
    "diff",
    "coding-agent",
    "code-review"
  ],
  "files": [
    "README.en.md",
    "src/",
    "integrations/",
    "web/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "focus-code": "src/cli.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.js watch",
    "demo": "node --disable-warning=ExperimentalWarning src/cli.js demo",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "semver": "^7.8.6",
    "tar": "^7.5.23"
  }
}
